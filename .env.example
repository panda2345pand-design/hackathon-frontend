# バックエンドの URL。ローカルの既定は http://localhost:8000。Vercel では Cloud Run の URL を入れる
VITE_API_URL=http://localhost:8000

# 認証モード: dev(名前だけでログイン。既定) / firebase(Firebase Authentication のメール+パスワード)
# バックエンドの AUTH_MODE と同じ値にそろえる
VITE_AUTH_MODE=dev

# VITE_AUTH_MODE=firebase のときだけ必要(Firebase コンソール → プロジェクトの設定 → ウェブアプリ)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
